#!/bin/sh
# Every test runs locally with host commands stubbed. Real sessions remain a host check.
set -eu
# The land gate unit sets AGENT_HARNESS=gate, which tools under test read as a default.
for v in $(env | sed -n 's/^\(AGENT_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done
for t in test/*.test.sh; do
    echo "gate > $t"
    sh "$t"
done
