# bash completion for the agent command dispatcher.
_agent() {
    local cur=${COMP_WORDS[COMP_CWORD]}
    if [ "$COMP_CWORD" -eq 1 ]; then
        local -a commands=()
        local command name existing duplicate
        while IFS= read -r command; do
            name=${command#agent-}
            [ "$name" != "$command" ] || continue
            [ -n "$name" ] && [ "$name" != agent ] || continue
            duplicate=false
            for existing in "${commands[@]}"; do
                if [ "$existing" = "$name" ]; then
                    duplicate=true
                    break
                fi
            done
            [ "$duplicate" = true ] || commands+=("$name")
        done < <(compgen -c agent-)
        COMPREPLY=($(compgen -W "${commands[*]}" -- "$cur"))
        return
    fi
    if [ "${COMP_WORDS[1]}" = verdict ]; then
        if ! declare -F _agent_verdict >/dev/null; then
            if declare -F _completion_loader >/dev/null; then
                _completion_loader agent-verdict || :
            fi
        fi
        if ! declare -F _agent_verdict >/dev/null; then
            local completion_file
            completion_file=$(readlink -f -- "${BASH_SOURCE[0]}") || completion_file=
            if [ -n "$completion_file" ] && [ -f "${completion_file%/*}/agent-verdict" ]; then
                . "${completion_file%/*}/agent-verdict"
            fi
        fi
        if declare -F _agent_verdict >/dev/null; then
            local -a original_words=("${COMP_WORDS[@]}")
            local original_cword=$COMP_CWORD
            COMP_WORDS=(agent-verdict "${COMP_WORDS[@]:2}")
            COMP_CWORD=$((original_cword - 1))
            _agent_verdict
            COMP_WORDS=("${original_words[@]}")
            COMP_CWORD=$original_cword
        fi
        return
    fi
    COMPREPLY=($(compgen -f -- "$cur"))
}
complete -F _agent agent
