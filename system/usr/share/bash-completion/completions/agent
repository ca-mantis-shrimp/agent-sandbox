# bash completion for the agent command dispatcher.
_agent_completion_dir=${BASH_SOURCE[0]%/*}
_agent() {
    local cur=${COMP_WORDS[COMP_CWORD]}
    if [ "$COMP_CWORD" -eq 1 ]; then
        local commands=() script name
        for script in "$_agent_completion_dir"/../../../../../bin/agent-*; do
            [ -f "$script" ] || continue
            name=${script##*/agent-}
            commands+=("$name")
        done
        COMPREPLY=($(compgen -W "${commands[*]}" -- "$cur"))
        return
    fi
    if [ "${COMP_WORDS[1]}" = verdict ]; then
        if ! declare -F _agent_verdict >/dev/null; then
            . "$_agent_completion_dir/agent-verdict"
        fi
        local -a original_words=("${COMP_WORDS[@]}")
        local original_cword=$COMP_CWORD
        COMP_WORDS=(agent-verdict "${COMP_WORDS[@]:2}")
        COMP_CWORD=$((original_cword - 1))
        _agent_verdict
        COMP_WORDS=("${original_words[@]}")
        COMP_CWORD=$original_cword
        return
    fi
    COMPREPLY=($(compgen -f -- "$cur"))
}
complete -F _agent agent
