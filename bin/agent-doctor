#!/bin/sh
#
# Check this host for what the sandbox needs, one line per check. Read-only:
# it reports and changes nothing (see README.md, Host setup).
#
#   agent-doctor
#
# Exit 0 when every required check passes, 1 otherwise. Notes (credentials a
# harness needs, lingering) are reported but do not fail it: a host may use
# only one harness, or run sessions only while logged in.
set -u

failed=0
ok() { printf 'agent-doctor > ok       %s\n' "$*"; }
missing() { printf 'agent-doctor > MISSING  %s\n' "$*"; failed=1; }
note() { printf 'agent-doctor > note     %s\n' "$*"; }

for tool in git jq flock systemctl podman; do
    if command -v "$tool" >/dev/null; then ok "$tool"; else missing "$tool"; fi
done

user=$(id -un)
# Sessions run as uid 1000 under --userns=keep-id; commits are the host
# user's only when the host user is uid 1000 too.
if [ "$(id -u)" = 1000 ]; then ok "uid 1000"; else missing "uid 1000 (this user is $(id -u))"; fi

if command -v podman >/dev/null; then
    # Quadlet, which runs every session, arrived in Podman 4.4.
    version=$(podman version --format '{{.Client.Version}}' 2>/dev/null)
    if printf '4.4\n%s\n' "$version" | sort -V -C; then
        ok "podman $version (Quadlet needs 4.4)"
    else
        missing "podman 4.4 or newer for Quadlet (found ${version:-none})"
    fi
    for f in /etc/subuid /etc/subgid; do
        if grep -q "^$user:" "$f" 2>/dev/null; then ok "$f has $user"; else missing "$f has no range for $user (rootless podman)"; fi
    done
    if podman secret exists claude_token 2>/dev/null; then
        ok "claude_token secret"
    else
        note "no claude_token podman secret: Claude sessions cannot start"
    fi
    # pi keeps its login in auth.json, which a session without one leaves as
    # {}; the volume is readable only inside podman's user namespace.
    pi_volume=$(podman volume inspect agent-pi --format '{{.Mountpoint}}' 2>/dev/null)
    if [ -n "$pi_volume" ] && podman unshare jq -e 'length > 0' "$pi_volume/auth.json" >/dev/null 2>&1; then
        ok "pi login in the agent-pi volume"
    else
        note "no pi login in the agent-pi volume: pi sessions cannot start (README.md, Host setup)"
    fi
fi

if [ "$(loginctl show-user "$user" -p Linger --value 2>/dev/null)" = yes ]; then
    ok "lingering"
else
    note "lingering is off: sessions stop when $user logs out (loginctl enable-linger)"
fi
exit "$failed"
