#!/bin/sh
# Read-only host checks, or explicit host-clone hook installation.
# The root-only Claude credential is a note.
set -u
tool=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
if [ "$#" -gt 0 ]; then
    [ "$#" -eq 2 ] && [ "$1" = --install-hooks ] || {
        echo 'usage: agent-doctor [--install-hooks <repo>]' >&2; exit 2;
    }
    (
        set -eu
        cd -- "$2"
        root=$(git rev-parse --show-toplevel)
        cd -- "$root"
        hooks=$(git rev-parse --git-path hooks)
        hook="$hooks/pre-commit"
        # Honor core.hooksPath, but never replace an existing human hook.
        if [ -e "$hook" ] || [ -L "$hook" ]; then
            if cmp -s "$tool/lib/agent-pre-commit.sh" "$hook"; then
                chmod +x "$hook"
                echo "agent-doctor > claim guard already installed: $hook"
                exit 0
            fi
            echo "agent-doctor > refusing to replace existing hook: $hook" >&2
            exit 1
        fi
        mkdir -p "$hooks"
        # Noclobber also refuses a hook created after the check above.
        (set -C; command cat "$tool/lib/agent-pre-commit.sh" >"$hook")
        chmod +x "$hook"
        echo "agent-doctor > installed claim guard: $hook"
    )
    exit $?
fi
failed=0
ok() { printf 'agent-doctor > ok       %s\n' "$*"; }
missing() { printf 'agent-doctor > MISSING  %s\n' "$*"; failed=1; }
note() { printf 'agent-doctor > note     %s\n' "$*"; }
for cmd in git jq flock systemctl; do
    if command -v "$cmd" >/dev/null; then ok "$cmd"; else missing "$cmd"; fi
done
version=$(systemctl --version 2>/dev/null | awk 'NR == 1 {print $2}')
case "$version" in
    ''|*[!0-9]*) missing "systemd 257 or newer (found ${version:-none})" ;;
    *) if [ "$version" -ge 257 ]; then ok "systemd $version"; else missing "systemd 257 or newer (found $version)"; fi ;;
esac
if [ "$(systemctl show agent@doctor.service -p LoadState --value 2>/dev/null)" = loaded ]; then
    ok 'agent@.service installed'
else
    missing 'agent@.service not installed'
fi
case " $(id -Gn) " in
    *' agents '*) ok 'calling process is in agents group' ;;
    *) missing 'calling process is not in agents group (membership needs a fresh login; polkit uses process groups)' ;;
esac
if [ -n "${AGENT_BASE:-}" ] && [ -d "$AGENT_BASE" ]; then ok "base tree $AGENT_BASE"
else missing "AGENT_BASE tree (${AGENT_BASE:-unset})"; fi
if [ -n "${AGENT_LAYERS:-}" ] && [ -f "$AGENT_LAYERS/harness.raw" ]; then ok "harness layer $AGENT_LAYERS/harness.raw"
else missing "AGENT_LAYERS/harness.raw (${AGENT_LAYERS:-unset})"; fi
if [ -r /etc/credstore/agent.claude_token ]; then ok '/etc/credstore/agent.claude_token readable'
else note 'Claude sessions need /etc/credstore/agent.claude_token (plain) or /etc/credstore.encrypted/agent.claude_token (sealed with systemd-creds encrypt, e.g. to the TPM); neither root-only credstore can be checked from this user'; fi
# Use the same installed defaults and launching-environment overrides as agent-run.
. "$tool/agents/models.env"
login="${AGENT_RUNS:-/var/lib/agent-runs}/.pi/auth.json"
# Inspect only: pi need not be installed on the host, and OAuth refresh would
# rotate tokens underneath running sessions. Never print credential contents.
if jq -e --arg provider "$AGENT_PI_PROVIDER" \
    'type == "object" and has($provider)' "$login" >/dev/null 2>&1; then
    ok "shared pi login for provider $AGENT_PI_PROVIDER ($login)"
else
    missing "shared pi login for provider $AGENT_PI_PROVIDER ($login): unreadable, invalid, or provider absent"
fi
# Linux proc socket tables on the little-endian hosts used by the images.
# Override the directory for fixture tests; inspect only LISTEN (0A) sockets.
proc_net=${AGENT_PROC_NET:-/proc/net}
if [ -r "$proc_net/tcp" ] && [ -r "$proc_net/tcp6" ]; then
    listeners=$(awk '
        function hex(s,    n,i) {
            n=0
            for (i=1; i<=length(s); i++)
                n=n*16+index("0123456789ABCDEF", substr(s,i,1))-1
            return n
        }
        $4 == "0A" {
            split(toupper($2), local, ":")
            addr=local[1]; port=hex(local[2]); label=""
            if (length(addr) == 8) {
                if (addr == "00000000" || substr(addr,7,2) == "7F")
                    label=hex(substr(addr,7,2)) "." hex(substr(addr,5,2)) "." \
                        hex(substr(addr,3,2)) "." hex(substr(addr,1,2)) ":" port
            } else if (addr == "00000000000000000000000000000000") {
                label="[::]:" port
            } else if (addr == "00000000000000000000000001000000") {
                label="[::1]:" port
            }
            if (label != "" && !seen[label]++) {
                printf "%s%s", sep, label; sep=" "
            }
        }
    ' "$proc_net/tcp" "$proc_net/tcp6")
    note "TCP listeners reachable through loopback: ${listeners:-none}"
else
    note "TCP listeners reachable through loopback: unavailable (cannot read $proc_net/tcp and tcp6)"
fi
exit "$failed"
