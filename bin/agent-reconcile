#!/bin/sh
# Finalize sessions whose unit has stopped, including ones whose launcher did
# not wait for them: write the session's terminal state, outcome, exit code and
# the commits it made into its record. The static unit is retained.
#
#   agent-reconcile <workspace>        every session that has ended
#   agent-reconcile <workspace>/<n>    that session
#
# Idempotent; never touches a session whose unit is still active. Exit 2 when
# a session it was asked about is still active or its unit's result is gone.
set -eu

ref=${1:?usage: agent-reconcile <workspace>[/<n>]}
tool=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$tool/lib/agent-systemd.sh"
. "$tool/lib/agent-runs.sh"
ws=$(ref_workspace "$ref")
only=$(ref_session "$ref")
run="$(runs_dir)/$ws"
test -f "$run/manifest.json" || { echo "agent-reconcile > no workspace $ws" >&2; exit 1; }

if [ "${AGENT_WORKSPACE_LOCKED:-}" != "$ws" ]; then
    lock=$(agent_lock_path "$ws")
    exec 9>"$lock"
    flock 9
fi
status=0
for n in ${only:-$(running_sessions "$run")}; do
    record="$run/sessions/$n.json"
    test -f "$record" || { echo "agent-reconcile > no session $ws/$n" >&2; exit 1; }
    [ "$(jq -r .state "$record")" = running ] || continue
    unit=$(agent_unit "$ws")
    if agent_unit_active "$ws"; then
        [ -n "$only" ] && { echo "agent-reconcile > $unit is still active" >&2; status=2; }
        continue
    fi
    props=$(agent_unit_props "$ws" 2>/dev/null) || props=
    result=$(printf '%s\n' "$props" | sed -n 's/^Result=//p')
    code=$(printf '%s\n' "$props" | sed -n 's/^ExecMainCode=//p')
    mstatus=$(printf '%s\n' "$props" | sed -n 's/^ExecMainStatus=//p')
    if [ -z "$result" ] || [ -z "$code" ] || [ -z "$mstatus" ]; then
        echo "agent-reconcile > unit result unavailable for $ws/$n; leaving its record for inspection" >&2
        status=2
        continue
    fi
    stop_requested=0
    [ -f "$run/sessions/$n.stop" ] && stop_requested=1
    outcome=$(classify_agent_outcome "$result" "$code" "$mstatus" "$stop_requested")
    case "$outcome" in
        finished) state=finished ;;
        stopped*) state=stopped ;;
        *) state=failed ;;
    esac
    commits='{}'
    [ -d "$run/work" ] && commits=$(repo_commits "$run/work" "refs/agent/session-$n")

    # Keep the unit and its properties until the record is durable. A later
    # invocation can retry if writing it fails.
    jq --arg state "$state" --arg outcome "$outcome" --argjson code "${mstatus:-1}" \
        --arg finished "$(date -Iseconds)" --argjson commits "$commits" \
        '. + {state: $state, outcome: $outcome, exit: $code, finished: $finished, commits: $commits}' \
        "$record" >"$record.tmp"
    session_json "$run" "$(cat "$record.tmp")" >"$record.enriched"
    mv "$record.enriched" "$record"
    rm -f "$record.tmp"

    echo "agent-reconcile > $ws/$n $state ($outcome)"
done
exit "$status"
