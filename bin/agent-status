#!/bin/sh
# Show workspace, session and host-hold status.
#
# On-demand summary of agent workspaces, read from their records, transcripts
# and each workspace's system-manager unit.
#
#   agent-status --held <repo>      workspace + unit state; exit 0 held, 3 not held
#   agent-status                    one line per workspace
#   agent-status <workspace> [n]    its line, then the last n tool
#                                           calls of its newest session (default 10)
#
# The agent column is the newest session's model; the outcome column lists
# every session in order. idle is seconds since the newest transcript event:
# the heartbeat, with no hook into the harness. A session idle past
# $AGENT_STUCK_SECS (default 600) is flagged STUCK; a session whose record
# still says running with no active unit is finalized by agent-result
# (or the next agent-run in that workspace). spent counts finished
# sessions and shows - while one runs. This is the bridge until telemetry
# answers the same questions from the collector.
set -eu

tool=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$tool/lib/agent-systemd.sh"
. "$tool/lib/agent-runs.sh"
. "$tool/lib/agent-questions.sh"
runs=$(runs_dir)
if [ "${1:-}" = --held ]; then
    [ "$#" -eq 2 ] || { echo 'usage: agent-status --held <repo-path>' >&2; exit 2; }
    held_workspaces "$2"
    exit $?
fi

print_questions() { # <workspace-id> <question-list>
    [ -n "$2" ] || return 0
    count=$(printf '%s\n' "$2" | wc -l | tr -d ' ')
    printf '%s waiting questions: %s\n' "$1" "$count"
    printf '%s\n' "$2" | while IFS="$(printf '\t')" read -r q title; do
        printf '  %s/%s  %s\n' "$1" "$q" "$title"
    done
}

show_questions() { # <workspace-dir> <workspace-id>
    waiting=$(waiting_questions "$1" "$2")
    print_questions "$2" "$waiting"
}

if [ "${1:-}" = --wait-question ]; then
    [ "$#" -eq 1 ] || { echo 'usage: agent-status --wait-question' >&2; exit 2; }
    while :; do
        found=0
        for dir in "$runs"/*/; do
            [ -f "$dir/manifest.json" ] || continue
            jq -e '.retired == null' "$dir/manifest.json" >/dev/null 2>&1 || continue
            id=$(basename "${dir%/}")
            questions=$(waiting_questions "${dir%/}" "$id")
            if [ -n "$questions" ]; then
                print_questions "$id" "$questions"
                found=1
            fi
        done
        [ "$found" -eq 0 ] || exit 0
        sleep "${AGENT_QUESTION_POLL_SECS:-2}"
    done
fi
stuck=${AGENT_STUCK_SECS:-600}
now=$(date +%s)

epoch() { # <iso timestamp or empty>
    if [ -n "$1" ]; then date -d "$1" +%s; else echo "$now"; fi
}

latest_transcript() { # <run-dir>
    ls -t "$1"/transcripts/*.jsonl 2>/dev/null | head -n 1 || true
}

row() { # <workspace-dir>
    dir=$1
    id=$(basename "$dir")
    m=$(workspace_json "$dir")
    state=$(printf '%s' "$m" | jq -r 'if .retired then "retired" else .state end')
    latest=$(latest_transcript "$dir")
    events=0
    idle=-
    if [ -n "$latest" ]; then
        events=$(cat "$dir"/transcripts/*.jsonl | wc -l)
        idle=$((now - $(stat -c %Y "$latest")))
    fi
    flag=$(printf '%s' "$m" | jq -r 'if .retired then "retired" elif .landed then "landed" elif .harvested then "harvested" else "" end')
    if [ "$state" = running ]; then
        # The record says a session is running; the unit says whether it is.
        active=0
        for n in $(running_sessions "$dir"); do
            agent_unit_active "$id" && active=1
        done
        if [ "$active" -eq 0 ]; then
            flag=RECONCILE
        elif [ "$idle" != - ] && [ "$idle" -gt "$stuck" ]; then
            flag=STUCK
        fi
    elif [ "$state" = preparing ]; then
        flag=ORPHANED
    fi
    spent=\$$(printf '%s' "$m" | jq '[.sessions[]?.cost_usd // 0] | add // 0 | . * 100 | round / 100')
    # Cost lands when a session ends, so a live one has no honest figure yet.
    [ "$state" = running ] && spent=-
    finished=$(printf '%s' "$m" | jq -r '([.sessions[]?.finished // empty] | last) // .finished // empty')
    [ "$state" = running ] && finished=
    minutes=$((($(epoch "$finished") - $(epoch "$(printf '%s' "$m" | jq -r .started)")) / 60))
    printf '%-16s %-18s %-9s %4sm  idle %-6s events %-5s spent %-7s %-12s %s\n' \
        "$id" "$(printf '%s' "$m" | jq -r '(.sessions | last | .model) // .model // .harness // "-"')" \
        "$state" "$minutes" "$idle" "$events" "$spent" \
        "$(printf '%s' "$m" | jq -r '[.sessions[]? | .outcome as $o
            | if .action then $o
              elif .state == "running" then "running"
              elif .ok then "ok" else ($o // "not-ok") end] | join(",")')" "$flag"
}

# Harness-specific: Claude Code's stream-json. Moves into the claude adapter
# when adapters exist; pi's json mode needs its own.
claude_recent() { # <transcript> <n>
    jq -r 'select(.type == "assistant") | .message.content[]? | select(.type == "tool_use")
        | "  \(.name)  \((.input.command // .input.file_path // .input.pattern // .input.description // "")
            | tostring | gsub("\n"; " ") | .[0:100])"' "$1" | tail -n "$2"
}

pi_recent() { # <transcript> <n>
    jq -r 'select(.type == "message_end") | .message.content[]? | select(.type == "toolCall")
        | "  \(.name)  \((.arguments.command // .arguments.path // "")
            | tostring | gsub("\n"; " ") | .[0:100])"' "$1" | tail -n "$2"
}

if [ $# -gt 0 ]; then
    dir="$runs/$1"
    test -f "$dir/manifest.json" || { echo "agent-status > no run at $dir" >&2; exit 1; }
    row "$dir"
    show_questions "$dir" "$1"
    latest=$(latest_transcript "$dir")
    if [ -n "$latest" ]; then
        if [ "$(workspace_json "$dir" | jq -r '(.sessions | last | .harness) // .harness // "claude"')" = pi ]; then
            pi_recent "$latest" "${2:-10}"
        else
            claude_recent "$latest" "${2:-10}"
        fi
    fi
    exit 0
fi

for dir in "$runs"/*/; do
    if [ -f "$dir/manifest.json" ] && ! jq -e '.retired != null' "$dir/manifest.json" >/dev/null; then
        row "${dir%/}"
        show_questions "${dir%/}" "$(basename "${dir%/}")"
    fi
done
