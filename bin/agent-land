#!/bin/sh
#
# Land a harvested workspace: merge branch agent/<id> into the checked-out
# branch of every repo, bottom-up, gate the result, then delete the branch.
#
#   agent-land <id>
#
# No real branch moves until the gate passes. The merge is built in a candidate
# clone, $AGENT_RUNS/<id>/candidate: submodules merge first, then the root repo,
# which pins each submodule at its merged HEAD. (Merging the root alone lets git
# keep one side's pin and silently drop the other side's submodule work.) The
# gate runs on the candidate in the sandbox image, built from the candidate's
# own Containerfile (with the sandbox's layer over it), so every tool it needs
# is declared there: .sandbox/setup
# is sourced, then .sandbox/gate runs ($AGENT_LAND_GATE overrides it). Only
# when it passes are the real branches fast-forwarded, submodules first.
#
# Stops on a content conflict: resolve and commit it in the candidate, then
# rerun (finished merges are skipped). A red gate leaves every real branch
# where it was; the candidate and gate.log stay as evidence. A real branch that
# moved since the candidate was built stops the landing before anything
# advances: remove the candidate and rerun.
#
# Fast-forwarding several repos is not atomic. If one fails partway, the repos
# before it have advanced and the message says which; fix the cause and rerun,
# which skips repos already at the candidate.
#
# Pushing stays a separate, human step. The workspace's clone and candidate are
# removed; its manifest, gate.log and transcripts stay as the record.
set -eu

id=${1:?usage: agent-land <id>}
tool=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$tool/lib/agent-runs.sh"
branch="agent/$id"
run="$(runs_dir)/$id"
repo=$(workspace_repo "$run")
cand="$run/candidate"
image="$(basename "$repo")-agent:land-$id"
gate=${AGENT_LAND_GATE:-.sandbox/gate}
submodules=$(git -C "$repo" config --file "$repo/.gitmodules" --get-regexp '\.path$' 2>/dev/null | awk '{print $2}')

say() { echo "agent-land > $*" >&2; }
stop() {
    say "$*"
    exit 1
}
name() { # <repo path relative to the repo>
    if [ "$1" = . ]; then basename "$repo"; else printf '%s\n' "$1"; fi
}
manifest() { # merge a jq expression into manifest.json, when the workspace has one
    [ -f "$run/manifest.json" ] || return 0
    jq "$@" "$run/manifest.json" >"$run/manifest.tmp" && mv "$run/manifest.tmp" "$run/manifest.json"
}
pending() { # <repo-dir>: the workspace's branch exists here and is not merged yet
    git -C "$1" rev-parse -q --verify "refs/heads/$branch" >/dev/null &&
        ! git -C "$1" merge-base --is-ancestor "$branch" HEAD
}

# Clone the real checkout, each repo on its real branch's name so merge
# messages read as before, and mark where each started: refs/agent/land-base.
build_candidate() {
    [ -d "$cand" ] && return 0
    say "building the candidate in $cand"
    mkdir -p "$run"
    clone_local "$repo" "$cand"
    for sm in . $submodules; do
        real_branch=$(git -C "$repo/$sm" symbolic-ref -q --short HEAD) ||
            stop "$(name "$sm") is on a detached HEAD; switch it to its default branch first"
        git -C "$cand/$sm" switch -q -C "$real_branch"
        git -C "$cand/$sm" update-ref refs/agent/land-base HEAD
    done
}

# The workspace's branch as harvested into the real repos. Fetched on every
# run, so commits harvested after a stopped landing are merged too.
fetch_branch() {
    found=0
    for sm in . $submodules; do
        git -C "$repo/$sm" rev-parse -q --verify "refs/heads/$branch" >/dev/null || continue
        git -C "$cand/$sm" fetch -q --no-recurse-submodules "$repo/$sm" "+$branch:$branch"
        found=1
    done
    [ "$found" -eq 1 ] || stop "no repo has $branch; harvest it first (agent-harvest $id)"
}

# A workspace's clone may hold commits nobody harvested; landing without them
# would delete the only copy. A repo the workspace left alone has no branch
# to harvest: its tip is already in HEAD.
check_harvested() {
    [ -d "$run/work" ] || return 0
    for sm in . $submodules; do
        tip=$(git -C "$run/work/$sm" rev-parse -q --verify "refs/heads/$branch") || continue
        git -C "$repo/$sm" merge-base --is-ancestor "$tip" "$branch" 2>/dev/null ||
            git -C "$repo/$sm" merge-base --is-ancestor "$tip" HEAD 2>/dev/null ||
            stop "$(name "$sm"): the workspace has commits on $branch that are not harvested; run agent-harvest $id"
    done
}

merge_candidate() {
    for sm in $submodules; do
        pending "$cand/$sm" || continue
        say "merging $branch into $sm"
        git -C "$cand/$sm" merge --no-ff --no-edit -q "$branch" ||
            stop "conflict in $sm: resolve and commit it in $cand/$sm, then rerun"
    done
    (
        cd "$cand"
        if pending .; then
            say "merging $branch into $(name .)"
            # Pin conflicts are expected and resolved below; anything else stops.
            git merge --no-ff --no-commit -q "$branch" >/dev/null 2>&1 || true
            conflicts=$(git diff --name-only --diff-filter=U | grep -vxF "$submodules" || true)
            [ -z "$conflicts" ] ||
                stop "conflict in $(name .): $conflicts; resolve and commit it in $cand, then rerun"
        fi
        # Pin every submodule at its merged HEAD.
        # shellcheck disable=SC2086
        [ -z "$submodules" ] || git add $submodules
        if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
            git commit -q --no-edit
        elif ! git diff --cached --quiet; then
            git commit -q -m "Pin submodules: land $branch"
        fi
    )
}

gate_candidate() {
    say "gating the candidate: $gate in $image (log: $run/gate.log)"
    ok=true
    {
        # The same limits and cache volumes as a session; the volume list is
        # validated to plain names and paths, so word splitting is safe.
        memory=$(session_memory)
        volumes=$(repo_volumes "$cand" | sed 's/^/-v /') &&
        build_agent_image "$cand" "$image" &&
            # shellcheck disable=SC2086
            podman run --rm --userns=keep-id --cpus "$(session_cpus)" --memory "$memory" --memory-swap "$memory" \
                -v "$cand:/job/land-$id/work" -w "/job/land-$id/work" $volumes \
                "$image" sh -c '[ ! -f .sandbox/setup ] || . ./.sandbox/setup; exec "$0"' "$gate"
    } >"$run/gate.log" 2>&1 || ok=false
    manifest --arg at "$(date -Iseconds)" --argjson ok "$ok" '.gate = {at: $at, ok: $ok, log: "gate.log"}'
    [ "$ok" = true ] || {
        tail -n 20 "$run/gate.log" >&2
        stop "the gate failed; no real branch moved. Evidence: $run/gate.log and $cand"
    }
}

# Every real branch must still be where its candidate started, or already at
# the candidate (a rerun after a partial advance), before any of them moves.
advance() {
    for sm in . $submodules; do
        real=$(git -C "$repo/$sm" rev-parse HEAD)
        [ "$real" = "$(git -C "$cand/$sm" rev-parse refs/agent/land-base)" ] ||
            [ "$real" = "$(git -C "$cand/$sm" rev-parse HEAD)" ] ||
            stop "$(name "$sm") moved since the candidate was built; nothing advanced. Remove $cand and rerun"
    done
    advanced=""
    for sm in $submodules .; do
        tip=$(git -C "$cand/$sm" rev-parse HEAD)
        [ "$(git -C "$repo/$sm" rev-parse HEAD)" = "$tip" ] && continue
        git -C "$repo/$sm" fetch -q --no-recurse-submodules "$cand/$sm" "$(git -C "$cand/$sm" symbolic-ref HEAD)"
        git -C "$repo/$sm" merge --ff-only -q "$tip" ||
            stop "could not fast-forward $(name "$sm");${advanced:- nothing} advanced. Fix it and rerun"
        advanced="$advanced $(name "$sm")"
    done
}

cleanup() {
    for sm in . $submodules; do
        git -C "$repo/$sm" branch -q -d "$branch" 2>/dev/null || true
    done
    rm -rf "$run/work" "$cand"
    podman rmi -f "$image" "$image-toolchain" >/dev/null 2>&1 || true
    manifest --arg at "$(date -Iseconds)" '.landed = $at'
}

# Advisory only: a later fixer does not silently reconcile a review finding.
# The human can record reconciliation on the finding in the session record.
workspace='{}'
if [ -f "$run/manifest.json" ]; then
    if workspace=$(workspace_json "$run"); then
        printf '%s\n' "$workspace" | jq -r -L "$tool/lib" '
            include "agent-review"; blocking_review_lines' >&2 ||
            say "warning: could not display blocking review findings"
    else
        workspace='{}'
        say "warning: could not load workspace reviews for landing advisories"
    fi
fi
build_candidate
fetch_branch
check_harvested
merge_candidate
gate_candidate
advance
cleanup
say "landed $branch; push when ready"
human_verdict_reminder "$id" "$workspace" ||
    say "warning: could not display the human verdict reminder"
