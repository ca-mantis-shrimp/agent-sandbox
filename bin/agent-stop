#!/bin/sh
#
# Ask running sessions to stop early and gracefully (SIGTERM, then SIGKILL
# after the unit's TimeoutStopSec).
#
#   agent-stop <workspace>        every running session in it
#   agent-stop <workspace>/<n>    that session
#
# The stop is recorded, so agent-result reports the session as stopped
# rather than failed.
set -eu

ref=${1:?usage: agent-stop <workspace>[/<n>]}
tool=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$tool/lib/agent-quadlet.sh"
. "$tool/lib/agent-runs.sh"
ws=$(ref_workspace "$ref")
only=$(ref_session "$ref")
run="$(runs_dir)/$ws"
test -d "$run/sessions" || { echo "agent-stop > no workspace $ws" >&2; exit 1; }

stopped=0
for n in ${only:-$(running_sessions "$run")}; do
    unit_id=$(session_unit_id "$ws" "$n")
    agent_unit_active "$unit_id" || continue
    : >"$run/sessions/$n.stop"
    systemctl --user stop "$(quadlet_unit "$unit_id").service"
    echo "agent-stop > stop requested for $ws/$n"
    stopped=1
done
[ "$stopped" -eq 1 ] || { echo "agent-stop > nothing running in $ref" >&2; exit 1; }
