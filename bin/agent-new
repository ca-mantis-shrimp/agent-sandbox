#!/bin/sh
#
# Create a workspace for sandboxed agent sessions: a disposable clone of this
# repo that any number of sessions, from any harness, can then work in.
#
#   scripts/agent-new      prints the workspace id on stdout; progress on stderr
#
# The workspace is $AGENT_RUNS/<id>/ (default ~/agent-runs):
#   work/          a clone of the repo at HEAD, every repo on branch agent/<id>
#   agents/        the harness snapshot every session in it uses
#   manifest.json  id, base commit, branch, state (preparing, ready or failed)
#   sessions/, prompts/, transcripts/   filled by scripts/agent-run
#
# Add sessions with scripts/agent-run --in <id>; bring its commits back with
# scripts/agent-harvest <id>. The clone has no git credentials, so commits are
# a workspace's only output.
#
# Needs podman (the image is built from the repo's root Containerfile).
set -eu

say() { echo "agent-new > $*" >&2; }

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$root/scripts/lib/agent-runs.sh"
# One image per repo, built from its root Containerfile.
image="$(basename "$root")-agent"
runs=$(runs_dir)
mkdir -p "$runs"
# The id is a timestamp; mkdir claims it, so two launches in one second (agents
# start workspaces in parallel) cannot share a directory.
until id=$(date +%Y%m%d-%H%M%S) && mkdir "$runs/$id" 2>/dev/null; do sleep 1; done
run="$runs/$id"
branch="agent/$id"

mkdir "$run/sessions" "$run/prompts" "$run/transcripts"
cp -R "$root/agents" "$run/agents"
manifest() { # merge a jq expression into manifest.json
    jq "$@" "$run/manifest.json" >"$run/manifest.tmp" && mv "$run/manifest.tmp" "$run/manifest.json"
}
jq -n --arg id "$id" --arg base "$(git -C "$root" rev-parse HEAD)" --arg started "$(date -Iseconds)" \
    '{id: $id, base: $base, branch: "agent/\($id)", state: "preparing", started: $started}' \
    >"$run/manifest.json"

# Keep a terminal record if any preparation step fails under `set -e`.
on_exit() {
    code=$?
    if [ "$code" -ne 0 ]; then
        manifest --argjson code "$code" --arg finished "$(date -Iseconds)" \
            '.state = "failed" | .outcome = "failed:preparation" | .exit = $code | .finished = $finished' || true
        say "preparation failed (exit $code); see $run"
    fi
}
trap on_exit EXIT

say "cloning $(basename "$root") into $run/work"
clone_local "$root" "$run/work"
cd "$run/work"
# refs/agent/base marks where each repo started, so harvest counts exactly the
# workspace's commits.
git switch -q -c "$branch" && git update-ref refs/agent/base HEAD
git submodule -q foreach "git switch -q -c $branch && git update-ref refs/agent/base HEAD"

# pi reuses the host's user-level config, minus packages that break headless,
# sandboxed runs: background tasks outlive the session, remote-pi opens a
# control channel, pi-memory carries state between runs. Its login is the
# sandbox's own, in the agent-pi volume, never the host's auth.json.
jq '.packages -= ["npm:pi-background-tasks@latest", "npm:remote-pi", "npm:pi-memory", "npm:pi-mcp-adapter"]' \
    "$HOME/.pi/agent/settings.json" >"$run/pi-settings.json"

say "building image"
if ! podman build -q -t "$image" "$root" >"$run/build.log" 2>&1; then
    say "image build failed; see $run/build.log"
    tail -n 20 "$run/build.log" >&2
    exit 1
fi

manifest --arg image "$image" '.state = "ready" | .image = $image'
echo "$id"
