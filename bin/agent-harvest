#!/bin/sh
#
# Bring a workspace's commits back into the checkout it was cloned from.
#
#   agent-harvest <workspace>
#
# Fetches branch agent/<workspace> from session bundles into that repo and each
# submodule, prints what each repo gained and what each session said, and marks
# the workspace harvested. Nothing is merged, and the workspace stays usable:
# review the branches, add more sessions and harvest again, or land them with
# agent-land. Refuses while a session is still running in it.
set -eu

id=${1:?usage: agent-harvest <id>}
tool=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$tool/lib/agent-systemd.sh"
. "$tool/lib/agent-runs.sh"
run="$(runs_dir)/$id"
branch="agent/$id"
test -d "$run/work" || { echo "agent-harvest > no workspace at $run" >&2; exit 1; }
repo=$(workspace_repo "$run")
# Harvest what finished sessions left; a running one may still be committing.
"$tool/bin/agent-reconcile" "$id" >&2 || true
[ -z "$(running_sessions "$run")" ] ||
    { echo "agent-harvest > a session is still running in $id; wait for it or agent-stop $id" >&2; exit 1; }

n=$(latest_writer "$run")
data=$(session_export "$run" "$n")
[ "$data" != null ] || { missing_export "$id" "$n"; exit 1; }
# The export is advisory about which commits exist; the agent can only
# misreport its own work. Git verifies the objects received from its bundle.
repo_paths "$repo" | while IFS= read -r path; do
    commits=$(printf '%s' "$data" | jq -r --arg p "$path" '.[$p].base[]')
    if [ -z "$commits" ]; then
        printf 'agent-harvest > %s: no commits\n' "$path"
    else
        if [ "$path" = . ]; then file=root
        else file="sm-$(printf '%s' "$path" | jq -sRr @uri)"; fi
        # Copy to a host-owned regular file: an export symlink must not turn
        # a bundle fetch into a repository fetch (upload-pack reads config).
        bundle=$(mktemp)
        trap 'rm -f "$bundle"' EXIT
        source="$run/exports/$n/$file.bundle"
        [ ! -L "$run/exports/$n" ] && [ ! -L "$source" ] && [ -f "$source" ] || {
            echo "agent-harvest > not a regular bundle: $source" >&2; exit 1;
        }
        cp -P "$source" "$bundle"
        [ ! -L "$bundle" ] && [ -f "$bundle" ] || exit 1
        if ! verification=$(git -C "$repo/$path" bundle verify "$bundle" 2>&1); then
            printf '%s\n' "$verification" >&2
            exit 1
        fi
        git -C "$repo/$path" -c transfer.fsckObjects=true fetch -q --no-recurse-submodules "$bundle" "$branch:$branch"
        rm -f "$bundle"
        printf 'agent-harvest > %s (%s commits):\n' "$path" "$(git -C "$repo/$path" rev-list --count --no-walk $commits)"
        git -C "$repo/$path" log --oneline --no-walk $commits | sed 's/^/    /'
    fi
    [ "$(printf '%s' "$data" | jq -r --arg p "$path" '.[$p].dirty')" = false ] ||
        echo '    UNCOMMITTED in the run (not harvested)'
done

# Each session, in order: who worked, how it ended, what it said. (Manifests
# from before sessions had their own records call the closing message "why".)
workspace_json "$run" | jq -r -L "$tool/lib" 'include "agent-review";
    (.sessions[]? |
    "\nagent-harvest > \(.n // "") \(.model // "") \(.label // .action // "") \(if .action then .outcome elif .ok then "ok" else "not-ok" end) ($\(.cost_usd // 0))",
    (if .read_only then .review | review_lines else empty end),
    (.closing // .why // "")),
    (.reviews[]? | "\nagent-harvest > external review \(.id) by \(.reviewer)",
     (.review | review_lines))'
jq --arg at "$(date -Iseconds)" '.harvested = $at' "$run/manifest.json" >"$run/manifest.tmp" &&
    mv "$run/manifest.tmp" "$run/manifest.json"
printf '\nagent-harvest > review the branches, then land them with: agent-land %s\n' "$id"
