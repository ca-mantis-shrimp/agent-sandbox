#!/bin/sh
#
# Run a headless agent against a disposable clone of platform, in a container.
#
#   scripts/agent-run              work the unscheduled queue (agents/loop)
#   scripts/agent-run <action>     work just that action
#
# The run lives in $AGENT_RUNS/<id>/ (default ~/agent-runs):
#   work/          a clone of platform at HEAD, every repo on branch agent/<id>
#   agents/        the harness snapshot used for the whole run
#   transcripts/   one stream-json session per action
#   manifest.json  id, base commit, state, timestamps
#
# The container sees only the run directory. Its harness snapshot is mounted
# read-only so neither the agent nor later edits to the source can change it.
# It has no git credentials, so its output is commits; bring them back with
# scripts/agent-harvest <id>.
# Needs: podman; Claude runs need the `claude_token` podman secret.
# Set AGENT_HARNESS=pi for the sandbox's own Pi/Codex login instead.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
id=$(date +%Y%m%d-%H%M%S)
run="${AGENT_RUNS:-$HOME/agent-runs}/$id"
branch="agent/$id"
image=clearhead-agent
harness=${AGENT_HARNESS:-claude}
case "$harness" in claude|pi) ;; *) echo "agent-run > unknown harness: $harness" >&2; exit 2 ;; esac

mkdir -p "$run"
cp -R "$root/agents" "$run/agents"
manifest() { # merge a jq expression into manifest.json
    jq "$@" "$run/manifest.json" >"$run/manifest.tmp" && mv "$run/manifest.tmp" "$run/manifest.json"
}
jq -n --arg id "$id" --arg base "$(git -C "$root" rev-parse HEAD)" \
    --arg action "${1:-queue}" --arg harness "$harness" --arg started "$(date -Iseconds)" \
    '{id: $id, base: $base, branch: "agent/\($id)", action: $action, harness: $harness, state: "preparing", started: $started}' \
    >"$run/manifest.json"

echo "agent-run > cloning platform into $run/work"
git clone -q "$root" "$run/work"
cd "$run/work"
# .gitmodules points at GitHub; clone each submodule from the local checkout
# instead, so unpushed local commits are available too.
git submodule -q init
git config --file .gitmodules --get-regexp '^submodule\..*\.path$' |
    while read -r key path; do
        name=${key#submodule.}
        name=${name%.path}
        git config "submodule.$name.url" "$root/$path"
    done
# Git refuses local-path submodule clones by default; these are our own repos.
git -c protocol.file.allow=always submodule -q update --recursive
# refs/agent/base marks where each repo started, so harvest counts exactly the
# agent's commits.
git switch -q -c "$branch" && git update-ref refs/agent/base HEAD
git submodule -q foreach "git switch -q -c $branch && git update-ref refs/agent/base HEAD"

# pi reuses the host's user-level config, minus packages that break headless,
# sandboxed runs: background tasks outlive the session, remote-pi opens a
# control channel, pi-memory carries state between runs. Its login is the
# sandbox's own, in the agent-pi volume, never the host's auth.json.
pi_host="$HOME/.pi/agent"
jq '.packages -= ["npm:pi-background-tasks@latest", "npm:remote-pi", "npm:pi-memory", "npm:pi-mcp-adapter"]' \
    "$pi_host/settings.json" >"$run/pi-settings.json"

echo "agent-run > building image"
podman build -q -t "$image" "$root" >/dev/null

manifest '.state = "running"'
echo "agent-run > running $id (logs: $run/transcripts/)"
status=0
# Only expose the Claude secret to Claude runs; Pi uses its separate volume.
target=${1:-}
set --
if [ "$harness" = claude ]; then
    set -- --secret claude_token,type=env,target=CLAUDE_CODE_OAUTH_TOKEN
fi
podman run --rm --name "agent-$id" \
    --userns=keep-id \
    --memory 16g --cpus 8 --pids-limit 4096 \
    -e AGENT_MAX_ACTIONS -e AGENT_SESSION_USD -e AGENT_RUN_USD \
    -e AGENT_HARNESS="$harness" -e AGENT_PI_MODEL \
    -v "$run:/job" \
    -v "$run/agents:/agents:ro" \
    -v agent-cargo:/home/agent/.cargo/registry \
    -v agent-target:/home/agent/target \
    -v agent-pi:/home/agent/.pi/agent \
    -v "$run/pi-settings.json:/home/agent/.pi/agent/settings.json:ro" \
    -v "$pi_host/agents:/home/agent/.pi/agent/agents:ro" \
    "$@" "$image" /agents/loop ${target:+"$target"} || status=$?

if [ "$status" -eq 0 ]; then state=finished; else state=failed; fi
manifest --arg state "$state" --argjson code "$status" --arg finished "$(date -Iseconds)" \
    '.state = $state | .exit = $code | .finished = $finished'
echo "agent-run > $state (exit $status); harvest with: scripts/agent-harvest $id"
exit "$status"
