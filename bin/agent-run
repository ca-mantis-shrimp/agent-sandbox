#!/bin/sh
# Start one session on agent@<workspace>.service. One session at a time,
# including readers. Prints <workspace>/<n>; --wait waits for its result.
# Host base and prebuilt layers are declared by AGENT_BASE and AGENT_LAYERS.
set -eu
umask 002
say() { echo "agent-run > $*" >&2; }
prompt="" ws="" harness=${AGENT_HARNESS:-claude} model="" label="" readonly=false wait=0
while [ $# -gt 0 ]; do
    case "$1" in
        --prompt) prompt=${2:?--prompt needs a file or the prompt text}; shift 2 ;;
        --in) ws=${2:?--in needs a workspace id}; shift 2 ;;
        --harness) harness=${2:?--harness needs claude or pi}; shift 2 ;;
        --model) model=${2:?--model needs a model id}; shift 2 ;;
        --label) label=${2:?--label needs text}; shift 2 ;;
        --read-only) readonly=true; shift ;;
        --wait) wait=1; shift ;;
        *) say "unknown argument: $1"; exit 2 ;;
    esac
done
[ -n "$prompt" ] || { say "--prompt is required"; exit 2; }
case "$harness" in claude | pi) ;; *) say "unknown harness: $harness"; exit 2 ;; esac
if [ -f "$prompt" ]; then prompt_text=$(cat "$prompt"); else prompt_text=$prompt; fi
tool=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$tool/lib/agent-systemd.sh"
. "$tool/lib/agent-runs.sh"
[ -n "$ws" ] || ws=$("$tool/bin/agent-new")
unit=$(agent_unit "$ws")
run="$(runs_dir)/$ws"
[ "$(jq -r .state "$run/manifest.json" 2>/dev/null)" = ready ] && [ -d "$run/work" ] ||
    { say "$ws is not a ready workspace (landed, failed, or unknown)"; exit 1; }
# Only the installed checkout is trusted for host-side shell code.
. "$tool/agents/models.env"
if [ -z "$model" ]; then
    case "$harness" in claude) model=$AGENT_CLAUDE_MODEL ;; pi) model=$AGENT_PI_MODEL ;; esac
fi
lock=$(agent_lock_path "$ws")
exec 9>"$lock"
flock 9
if agent_unit_active "$ws"; then
    say "$unit is still active; only one session per workspace may run"
    exit 1
fi
# Attribute commits and preserve the last unit result before reusing the unit.
AGENT_WORKSPACE_LOCKED=$ws "$tool/bin/agent-reconcile" "$ws" >&2
[ -z "$(running_sessions "$run")" ] || { say "unreconciled session in $ws"; exit 1; }
n=$(($(find "$run/sessions" -name '*.json' | wc -l) + 1))
repo=$(workspace_repo "$run")
ensure_layers "$run" "$repo" >&2
hold_layers "$repo" || { say "could not lock the layers"; exit 1; }
layers=$(layers_json "$repo")
write_agent_run "$run" "$repo" "$harness" "$model" "$n" "$readonly"
printf '%s\n' "$prompt_text" >"$run/prompts/$n.md"
(
    cd "$run/work"
    git update-ref "refs/agent/session-$n" HEAD
    git submodule -q foreach --recursive "git update-ref refs/agent/session-$n HEAD"
)
jq -n --argjson n "$n" --arg label "$label" --arg harness "$harness" --arg model "$model" \
    --argjson ro "$readonly" --argjson layers "$layers" --arg started "$(date -Iseconds)" \
    '{n: $n, label: $label, harness: $harness, model: $model, read_only: $ro, layers: $layers,
      prompt: "prompts/\($n).md", state: "running", started: $started}' \
    >"$run/sessions/$n.json"
say "session $ws/$n: $harness $model as $unit (transcripts in $run/transcripts/)"
start_status=0
systemctl --no-ask-password start "$unit" || start_status=$?
if [ "$start_status" -ne 0 ]; then
    # A rejected start can leave the previous session's success properties on
    # this reused unit. Never attribute those to the new session. If the unit
    # is active (or temporarily unavailable), retain the running record instead.
    if ! agent_unit_active "$ws"; then
        jq --argjson code "$start_status" --arg at "$(date -Iseconds)" \
            '. + {state: "failed", outcome: "failed:start", exit: $code, finished: $at}' \
            "$run/sessions/$n.json" >"$run/sessions/$n.tmp"
        mv "$run/sessions/$n.tmp" "$run/sessions/$n.json"
    fi
    exit "$start_status"
fi
release_layers
flock -u 9
status=0
if [ "$wait" -eq 1 ]; then
    "$tool/bin/agent-result" "$ws/$n" --wait >/dev/null || status=$?
else
    say "started; result with: agent-result $ws/$n --wait"
fi
echo "$ws/$n"
exit "$status"
