#!/bin/sh
# Explicit root-only activation of a host-declared extension image.
set -eu
die() { echo "agent-host-install > $*" >&2; exit 1; }
[ $# -eq 1 ] || die 'usage: agent-host-install <agent-sandbox.raw>'
[ "$(id -u)" -eq 0 ] || die 'run as root'
[ -f "$1" ] && [ "$(basename -- "$1")" = agent-sandbox.raw ] || die 'expected an agent-sandbox.raw file'
# Override for fixture tests; live hosts use /var/lib/extensions.
extensions=${AGENT_EXTENSIONS:-/var/lib/extensions}
[ ! -d "$extensions/agent-sandbox" ] || die "directory extension present: $extensions/agent-sandbox (remove or relocate it explicitly)"
# A volatile directory extension also conflicts with this image.
[ ! -d /run/extensions/agent-sandbox ] || die 'directory extension present: /run/extensions/agent-sandbox'
mkdir -p "$extensions"
stage=$(mktemp "$extensions/.agent-sandbox.XXXXXX")
trap 'rm -f "$stage"' EXIT
cp "$1" "$stage"
chmod 0644 "$stage"
mv -f "$stage" "$extensions/agent-sandbox.raw"
systemd-sysext refresh
systemd-sysusers /usr/lib/sysusers.d/agent-sandbox.conf
systemd-tmpfiles --create /usr/lib/tmpfiles.d/agent-sandbox.conf
echo "agent-host-install > installed $extensions/agent-sandbox.raw"
