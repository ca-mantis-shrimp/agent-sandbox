#!/bin/sh
# Answer one question in a workspace's untrusted question inbox.
set -eu
say() { echo "agent-answer > $*" >&2; }
tool=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$tool/lib/agent-runs.sh"
. "$tool/lib/agent-systemd.sh"
. "$tool/lib/agent-questions.sh"
[ "$#" -eq 2 ] || { say 'usage: agent-answer <workspace>/<question> <text|file>'; exit 2; }
ref=$1 ws=${1%%/*} q=${1#*/} input=$2
case "$ref" in */*) ;; *) say 'question must be <workspace>/<question>'; exit 2 ;; esac
case "$ws" in ''|*[!A-Za-z0-9_-]*) say "invalid workspace: $ws"; exit 2 ;; esac
question_id_valid "$q" || { say "invalid question id: $q"; exit 2; }
run="$(runs_dir)/$ws"
[ -f "$run/manifest.json" ] || { say "no workspace: $ws"; exit 1; }
question_dir_safe "$run" || { say "unsafe or missing questions directory for $ws"; exit 1; }
question="$run/questions/$q.md"
session_file="$run/questions/$q.session"
question_file_safe "$question" 65536 || { say "refusing unsafe question: $question"; exit 1; }
question_file_safe "$session_file" 32 || { say "refusing unsafe question session record: $session_file"; exit 1; }
session=$(cat "$session_file") || { say 'cannot read question session'; exit 1; }
question_id_valid "$session" || { say 'invalid question session'; exit 1; }
record="$run/sessions/$session.json"
[ ! -L "$record" ] && [ -f "$record" ] || { say "unsafe session record: $record"; exit 1; }
jq -e --argjson n "$session" 'select(.state == "running" and .n == $n)' "$record" >/dev/null 2>&1 || {
    say "question $ws/$q is not from a running session"; exit 1;
}
agent_unit_active "$ws" || { say "session for $ws is not running"; exit 1; }
answer="$run/questions/$q.answer"
if [ -e "$answer" ] || [ -L "$answer" ]; then
    say "answer already exists or is unsafe: $answer"
    exit 1
fi
if [ -L "$input" ]; then say "refusing symlink input: $input"; exit 1; fi
if [ -f "$input" ]; then
    bytes=$(wc -c <"$input")
    [ "$bytes" -le 65536 ] || { say 'answer exceeds 65536 bytes'; exit 1; }
else
    bytes=$(printf '%s' "$input" | wc -c)
    [ "$bytes" -le 65536 ] || { say 'answer exceeds 65536 bytes'; exit 1; }
fi
# noclobber makes creation exclusive: an existing file or symlink is never
# replaced, even if it appeared after the checks above.
if [ -f "$input" ]; then
    (umask 002; set -C; cat "$input" >"$answer") || { say "could not create answer: $answer"; exit 1; }
else
    (umask 002; set -C; printf '%s\n' "$input" >"$answer") || { say "could not create answer: $answer"; exit 1; }
fi
say "answered $ws/$q"
