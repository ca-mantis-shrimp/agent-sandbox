#!/bin/sh
# pi's pin fixes its model list. Claude Code's postinstall links its native
# binary, so approve only that package's scripts.
set -eu
npm install -g --cache /tmp/npm-cache --allow-scripts=@anthropic-ai/claude-code @anthropic-ai/claude-code
npm install -g --cache /tmp/npm-cache --ignore-scripts @earendil-works/pi-coding-agent@0.99.2
