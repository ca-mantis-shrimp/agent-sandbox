# The sandbox's layer over a repository's image: the agent harnesses and the
# user sessions run as. The repository's root Containerfile is built first,
# as root, on any base it likes; it must provide git, jq and npm. This file is
# built FROM the result (build_agent_image in lib/agent-runs.sh).
ARG BASE
FROM ${BASE}
USER root

RUN for tool in git jq npm; do \
        command -v "$tool" >/dev/null || { echo "agent-sandbox: the repository's image needs $tool" >&2; exit 1; }; \
    done

# Claude Code's postinstall links its native binary; npm blocks dependency
# lifecycle scripts by default, so approve only that package. pi's pin fixes
# its model list (0.99.2 has gpt-6.1-sol).
RUN npm install -g --allow-scripts=@anthropic-ai/claude-code @anthropic-ai/claude-code \
    && npm install -g --ignore-scripts @earendil-works/pi-coding-agent@0.99.2

# uid 1000 so `podman run --userns=keep-id` maps the agent onto the host user
# and its commits in the mounted clone stay owned by that user. Written
# directly rather than with useradd, which not every base has. The agent owns
# /home/agent, including mount points the repository made there for its
# cache volumes (.sandbox/volumes).
RUN grep -q '^[^:]*:[^:]*:1000:' /etc/passwd \
        || echo 'agent:x:1000:1000:agent:/home/agent:/bin/sh' >>/etc/passwd \
    && { grep -q '^[^:]*:[^:]*:1000:' /etc/group || echo 'agent:x:1000:' >>/etc/group; } \
    && mkdir -p /home/agent/.pi/agent \
    && chown -R 1000:1000 /home/agent \
    && git config --system user.name agent \
    && git config --system user.email agent@localhost \
    && git config --system safe.directory '*'

ENV HOME=/home/agent
USER 1000
WORKDIR /job
