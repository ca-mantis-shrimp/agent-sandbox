# Default model per harness for sandboxed agent sessions. Sourced by
# scripts/agent-run from the workspace's own snapshot; each session's record
# says what actually ran. A variable already set in the launching environment
# wins, and --model wins over both, so one session can try another model:
#
#   AGENT_CLAUDE_MODEL=claude-opus-5-5 scripts/agent-run --prompt ...
#   scripts/agent-run --model claude-opus-5-5 --prompt ...
#
# Upgrading is a one-line change here. A new GPT model may also need a newer
# pi-coding-agent in the Containerfile: its pinned version fixes the model
# list (0.85.1 stops at gpt-6-sol; gpt-6.1-sol needs 0.99+).
: "${AGENT_CLAUDE_MODEL:=claude-sonnet-5-5}"
: "${AGENT_PI_MODEL:=gpt-6-sol}"
