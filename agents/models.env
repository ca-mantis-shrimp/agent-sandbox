# Default model per harness and pi provider for sandboxed sessions. Sourced by
# agent-run from the installed tool checkout, never the writable workspace;
# each session's record
# says what actually ran. A variable already set in the launching environment
# wins, and --model wins over model defaults, so one session can try another model:
# AGENT_PI_PROVIDER uses the same environment override, with no CLI flag.
#
#   AGENT_CLAUDE_MODEL=claude-opus-5-5 agent-run --prompt ...
#   agent-run --model claude-opus-5-5 --prompt ...
#
# Upgrading is a one-line change here. A new GPT model may also need a newer
# pi-coding-agent in agents/Containerfile: its pinned version fixes the model
# list (0.99.2 has gpt-6.1-sol).
: "${AGENT_CLAUDE_MODEL:=claude-sonnet-5-5}"
: "${AGENT_PI_PROVIDER:=openai}"
: "${AGENT_PI_MODEL:=gpt-6.1-sol}"
