# Model per harness for sandboxed agent runs. Sourced by scripts/agent-run
# (from the run's own snapshot, so manifest.json records what ran) and by
# agents/loop inside the container. A variable already set in the launching
# environment wins, so one run can try another model:
#
#   AGENT_CLAUDE_MODEL=claude-opus-5-5 scripts/agent-run <action>
#
# Upgrading is a one-line change here. A new GPT model may also need a newer
# pi-coding-agent in the Containerfile: its pinned version fixes the model
# list (0.85.1 stops at gpt-6-sol; gpt-6.1-sol needs 0.99+).
: "${AGENT_CLAUDE_MODEL:=claude-sonnet-5-5}"
: "${AGENT_PI_MODEL:=gpt-6-sol}"
