#!/bin/sh
#
# Container entrypoint for scripts/agent-run: work the unscheduled queue, one
# fresh agent session per action, re-querying after each (the clearhead skill's
# loop, driven by the shell instead of the model).
#
#   /agents/loop            the queue
#   /agents/loop <action>   just that action
#
# Each action is attempted at most once per run. Every outcome is acceptable:
# completed, blocked (NEEDS DECISION), or unfinished; the agent's closing
# message says why, and it goes into manifest.json with the session's cost.
# The run stops when no untried action is queued, or at a limit:
#   AGENT_MAX_ACTIONS      sessions per run          (default 10)
#   AGENT_SESSION_USD      spend cap per session     (default 3, /agents/session)
#   AGENT_RUN_USD          spend cap per run         (default 15)
set -eu

if [ "${1:-}" = --target-file ]; then
    [ "$#" -eq 2 ] && [ -f "$2" ] || { echo "loop > missing target file" >&2; exit 2; }
    target=$(cat "$2")
    [ -n "$target" ] || { echo "loop > empty target file" >&2; exit 2; }
    set -- "$target"
fi

cd /job/work
# The queue and outcome below need this branch's clearhead, which the repo's
# own setup provides (each session sources it again; the build is cached).
. ./.sandbox/setup >>/job/setup.log 2>&1
cd /job/work

max=${AGENT_MAX_ACTIONS:-10}
run_usd=${AGENT_RUN_USD:-15}
tried=/tmp/tried
: >"$tried"

queue() {
    clearhead query index unscheduled --format ids 2>/dev/null
}

outcome() { # <action-id>
    state=$(clearhead read actions --format json 2>/dev/null |
        jq -r --arg id "${1#urn:uuid:}" '.actions[] | select(.id == $id or .alias == $id) | .state' | head -n 1) || true
    case "$state" in
        completed) echo completed ;;
        blocked) echo blocked ;;
        *) echo unfinished ;;
    esac
}

spent() {
    jq '[.sessions[]?.cost_usd] | add // 0' /job/manifest.json
}

# One session on one action: the prompt is ours, the session is the runner's
# (/agents/session records exit, cost and closing message). The outcome is the
# action's real state afterwards, whatever the session's own ending was; both
# land in the manifest, so a completed action behind a failed session shows.
session() { # <action-id> <n>
    echo "$1" >>"$tried"
    echo "loop > session $2: $1"
    sed "s|{{ACTION}}|$1|g" /agents/prompt.md >/tmp/prompt.md
    /agents/session /tmp/prompt.md "${1#urn:uuid:}" || true
    jq --arg a "$1" --arg o "$(outcome "$1")" '.sessions[-1] += {action: $a, outcome: $o}' \
        /job/manifest.json >/tmp/manifest.json && cp /tmp/manifest.json /job/manifest.json
    jq -r '.sessions[-1] | "loop > session: \(.outcome), $\(.cost_usd)"' /job/manifest.json
}

if [ $# -gt 0 ]; then
    session "$1" 1
    exit 0
fi

n=0
while [ "$n" -lt "$max" ]; do
    if jq -e --argjson cap "$run_usd" '([.sessions[]?.cost_usd] | add // 0) >= $cap' /job/manifest.json >/dev/null; then
        echo "loop > spent \$$(spent) of AGENT_RUN_USD=$run_usd; stopping"
        exit 0
    fi
    action=$(queue | grep -vxF -f "$tried" | head -n 1 || true)
    [ -z "$action" ] && { echo "loop > no untried actions queued"; exit 0; }
    n=$((n + 1))
    session "$action" "$n"
done
echo "loop > reached AGENT_MAX_ACTIONS=$max"
